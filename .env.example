# PostgreSQL container
POSTGRES_DB=lead_magnet
POSTGRES_USER=lead_magnet
POSTGRES_PASSWORD=change-me

# Spring Boot application
DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/lead_magnet
DATABASE_USERNAME=lead_magnet
DATABASE_PASSWORD=change-me
AUTH_SECRET=replace-with-a-long-random-production-secret
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=true

# Vite uses its development proxy when these are unset.
# VITE_API_URL=https://api.example.com
# VITE_PUBLIC_BASE_URL=https://forms.example.com
